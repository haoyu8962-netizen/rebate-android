root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# 导入按字典序一组排列（不把 java / javax / kotlin 分到末尾），与生成器输出一致。
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Compose 函数名按惯例大写开头
ktlint_function_naming_ignore_when_annotated_with = Composable

# core:generated 的一致性测试由 Codex 先写、本仓库不改（APP-01 任务书 §0）。它的格式与 ktlint 1.8 的
# 这两条规则不一致，只对该目录关掉这两条；其余 ktlint 规则照常检查。
[core/generated/src/test/**.kt]
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_function-signature = disabled

# DS-01 的格式向量测试同样由 Codex 先写、本仓库不改；它的格式与上面同两条规则不一致，只对这一个文件关掉。
[core/designsystem/src/test/kotlin/com/couli/core/designsystem/FormatVectorTest.kt]
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_function-signature = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh}]
indent_size = 2

# APP-02a 的 Router 向量测试同样由 Codex 先写、本仓库不改；只对这一个文件关掉同两条规则。
[core/router/src/test/kotlin/com/couli/core/router/RouterVectorTest.kt]
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_when-entry-bracing = disabled
