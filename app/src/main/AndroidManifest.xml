<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只申请网络权限；其余系统权限按 specs/system-permissions 在各功能任务里登记（03 §4.9）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 第三方页容器的【在浏览器打开】（APP-04）：只查有没有浏览器（CATEGORY_APP_BROWSER），没有就不显示这个出口。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
    </queries>

    <application
        android:name=".CouliApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Couli"
        android:usesCleartextTraffic="false">

        <!--
            singleTop：App 已在前台时收到的深链走 onNewIntent，先过启动意图排队与统一入口守卫（03 §4.4）。
            深链 intent-filter 只在 src/debug、src/staging 的清单里声明（测试 scheme，needs.md N-05）。
            手机锁定竖屏（03 §10.4）。面向 API 36 时，系统在最小宽度 ≥ 600dp 的屏幕上忽略方向锁定，
            大屏布局按 03 §10.4 实现（内容区限宽居中、配置变化不丢状态），不依赖这里的锁定。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            系统分享接收（FU-CLIP C6；K17、K23）：只收 ACTION_SEND + text/plain。专用 Activity 当场抽候选、原文丢弃，再以不带内容的
            Intent 拉起 MainActivity（原文不进 MainActivity 的 Intent 与最近任务）。不进最近任务、不留历史、无界面。
        -->
        <activity
            android:name=".clipboard.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
